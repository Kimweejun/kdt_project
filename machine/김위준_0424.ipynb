   "source": [
    "import seaborn as sns\n",
    "from sklearn.preprocessing import LabelEncoder\n",
    "\n",
    "titanic = sns.load_dataset(\"titanic\")\n",
    "\n",
    "y = titanic.sex\n",
    "le = LabelEncoder()\n",
    "le.fit(y)\n",
    "sex = le.transform(y)\n",
    "sex"
   ]
